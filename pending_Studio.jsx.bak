  { icon: Coffee,  label: 'Years Experience',   value: '3+',   color: 'text-violet-400',  bg: 'bg-violet-500/10', border: 'border-violet-500/30' },
  { icon: Code2,   label: 'Technologies Used',  value: '30+',  color: 'text-emerald-400', bg: 'bg-emerald-500/10',border: 'border-emerald-500/30' },
