                  <div>
                    <h3 className="text-lg font-bold text-slate-100">{svc.title}</h3>
                    <p className="text-xs text-slate-400 mt-1.5 leading-relaxed">{svc.desc}</p>
                  </div>
                  <div className="flex flex-wrap gap-1.5">
