  { step: '01', title: 'Research & Design',   desc: 'Problem scoping, circuit/architecture planning, Figma wireframes.',       icon: Layers  },
  { step: '02', title: 'Prototype & Build',   desc: 'Rapid embedded or web prototyping with iterative hardware testing.',        icon: Cpu     },
  { step: '03', title: 'Integrate & Deploy',  desc: 'Cloud pipelines, Firebase, live device dashboards, CI/CD.',               icon: Globe   },
  { step: '04', title: 'Optimize & Document', desc: 'Performance tuning, code cleanup, full technical write-up & demo video.',  icon: Zap     },
];

const SERVICES = [
  {
    icon: Cpu,
    title: 'IoT & Embedded Systems',
    desc: 'ESP32, Arduino, MQTT, FreeRTOS firmware, custom PCB design, and cloud-connected sensor dashboards.',
    tags: ['ESP32', 'Arduino', 'MQTT', 'PCB'],
    color: 'cyan',
  },
  {
    icon: Globe,
    title: 'Web & 3D Development',
    desc: 'React + Vite SPAs, Three.js 3D scenes, Firebase real-time apps, and glassmorphism UI design.',
    tags: ['React', 'Three.js', 'Firebase', 'UI/UX'],
    color: 'violet',
  },
  {
    icon: Code2,
    title: 'Systems Programming',
    desc: 'C/C++ socket servers, multi-threaded task managers, memory-optimized algorithms, and CLI tools.',
