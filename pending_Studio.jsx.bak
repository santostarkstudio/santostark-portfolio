];

const colorMap = {
  cyan:    { ring: 'border-cyan-500/30',    bg: 'bg-cyan-500/10',    text: 'text-cyan-400',    tag: 'bg-cyan-500/15 text-cyan-400 border-cyan-500/30'    },
  violet:  { ring: 'border-violet-500/30',  bg: 'bg-violet-500/10',  text: 'text-violet-400',  tag: 'bg-violet-500/15 text-violet-400 border-violet-500/30'  },
  emerald: { ring: 'border-emerald-500/30', bg: 'bg-emerald-500/10', text: 'text-emerald-400', tag: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30' },
  amber:   { ring: 'border-amber-500/30',   bg: 'bg-amber-500/10',   text: 'text-amber-400',   tag: 'bg-amber-500/15 text-amber-400 border-amber-500/30'   },
};

/* ─────────────────────────────────────
   Animated counter
   ───────────────────────────────────── */
function AnimatedStat({ value, label, icon: Icon, color, bg, border }) {
  return (
    <motion.div
      variants={{ initial: { opacity: 0, y: 30 }, animate: { opacity: 1, y: 0 } }}
      whileHover={{ y: -5, scale: 1.03 }}
      className={`glass-card p-6 rounded-3xl border ${border} flex flex-col items-center text-center space-y-3 shadow-xl`}
    >
      <div className={`p-4 rounded-2xl ${bg} border ${border}`}>
        <Icon className={`w-7 h-7 ${color}`} />
      </div>
      <motion.span
        className={`text-4xl font-extrabold ${color}`}
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ delay: 0.3 }}
      >
        {value}
      </motion.span>
      <span className="text-xs text-slate-400 font-semibold tracking-wide">{label}</span>
    </motion.div>
  );
}

/* ─────────────────────────────────────
   Main Studio Page
   ───────────────────────────────────── */
export default function Studio() {
  const [availabilityPing, setAvailabilityPing] = useState(true);

