              <Sparkles className="w-3.5 h-3.5" /> By the Numbers
            </span>
            <h2 className="text-3xl font-extrabold text-slate-100">Studio at a Glance</h2>
          </div>
          <div className="grid grid-cols-2 lg:grid-cols-4 gap-5">
